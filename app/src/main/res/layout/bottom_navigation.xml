<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/bottomNavigation"
    android:layout_width="match_parent" android:layout_height="78dp" android:background="@color/nav_fundo"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="7dp"
    android:paddingEnd="7dp" android:paddingTop="7dp" android:paddingBottom="9dp" android:elevation="8dp">
    <LinearLayout android:id="@+id/navDescobrir" android:layout_width="0dp" android:layout_height="61dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_inativo" android:layout_marginHorizontal="2dp" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_gt_compass" android:tint="@color/nav_texto_inativo" android:contentDescription="Ícone de navegação"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_descobrir" android:textColor="@color/nav_texto_inativo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navGrupos" android:layout_width="0dp" android:layout_height="61dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_inativo" android:layout_marginHorizontal="2dp" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_gt_groups" android:tint="@color/nav_texto_inativo" android:contentDescription="Ícone de navegação"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_grupos" android:textColor="@color/nav_texto_inativo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navBiblioteca" android:layout_width="0dp" android:layout_height="61dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_inativo" android:layout_marginHorizontal="2dp" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_gt_gamepad" android:tint="@color/nav_texto_inativo" android:contentDescription="Ícone de navegação"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_biblioteca" android:textColor="@color/nav_texto_inativo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navPerfil" android:layout_width="0dp" android:layout_height="61dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_inativo" android:layout_marginHorizontal="2dp" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_gt_user" android:tint="@color/nav_texto_inativo" android:contentDescription="Ícone de navegação"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_perfil" android:textColor="@color/nav_texto_inativo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/navChat" android:layout_width="0dp" android:layout_height="61dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_inativo" android:layout_marginHorizontal="2dp" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_gt_chat" android:tint="@color/nav_texto_inativo" android:contentDescription="Ícone de navegação"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_chat" android:textColor="@color/nav_texto_inativo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
