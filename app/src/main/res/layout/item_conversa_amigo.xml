<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_jogo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/avatarAmigoConversa"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle"
        android:clipToOutline="true"
        android:contentDescription="Foto do amigo"
        android:scaleType="centerCrop"
        android:src="@drawable/avatar_real_1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nomeAmigoConversa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Jogador"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/apelidoAmigoConversa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@jogador"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ultimaMensagemAmigoConversa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Comece uma conversa!"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/indicadorNaoLida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Nova"
            android:textColor="@color/destaque"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/horarioUltimaConversa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/abrirConversaAmigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_botao_principal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="66dp"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Abrir"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
