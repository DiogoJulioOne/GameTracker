<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fundo" android:orientation="vertical">
  <ScrollView android:id="@+id/rootMain" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:background="@drawable/bg_tela_gametracker">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="24dp" android:orientation="vertical">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <com.example.gametracker.utils.MarcaGameTrackerView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GameTracker" android:textColor="@color/destaque" android:fontFamily="sans-serif-black" android:letterSpacing="-0.035" android:textSize="30sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/botaoPesquisarBiblioteca" android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_gt_search" android:tint="@color/texto" android:contentDescription="Pesquisar jogos" android:clickable="true" android:focusable="true"/>
        <ImageView android:id="@+id/botaoFiltroUnico" android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp" android:layout_marginStart="4dp" android:background="@drawable/bg_nav_inativo" android:src="@drawable/ic_gt_more_vertical" android:tint="@color/texto" android:contentDescription="Abrir filtros da Biblioteca" android:clickable="true" android:focusable="true"/>
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/borda"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Biblioteca" android:textColor="@color/texto" android:textSize="27sp" android:textStyle="bold"/>
      <TextView android:id="@+id/textoBoasVindas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Gerencie seus jogos e acompanhe seu progresso." android:textColor="@color/texto_secundario" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
      <LinearLayout android:id="@+id/buttonAbrirRanking" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="23dp" android:background="@drawable/bg_ranking_chamada" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:contentDescription="Abrir ranking de jogadores">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="4dp" android:src="@drawable/ic_gt_trophy" android:tint="@color/black" android:contentDescription=""/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ranking de Jogadores" android:textColor="@color/black" android:textSize="19sp" android:textStyle="bold"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Veja, edite ou remova pontuações." android:textColor="@color/black" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:layout_width="27dp" android:layout_height="wrap_content" android:text="›" android:textSize="38sp" android:textColor="@color/black" android:gravity="center"/>
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="@color/borda"/>
      <EditText android:id="@+id/editPesquisaJogos" style="@style/CampoTexto" android:layout_marginTop="14dp" android:hint="Buscar jogos..." android:inputType="text" android:imeOptions="actionSearch" android:visibility="gone"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/textoContagem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/texto_secundario" android:textSize="12sp" />
        <Button android:id="@+id/buttonAdicionarJogo" android:layout_width="wrap_content" android:layout_height="42dp" android:minWidth="110dp" android:paddingHorizontal="12dp" android:background="@drawable/bg_botao_principal" android:text="+ Adicionar jogo" android:textColor="@color/black" android:textAllCaps="false" android:textSize="12sp" android:textStyle="bold"/>
      </LinearLayout>
      <TextView android:id="@+id/textoVazio" android:layout_width="match_parent" android:layout_height="125dp" android:layout_marginTop="14dp" android:gravity="center" android:background="@drawable/bg_card_jogo" android:textColor="@color/texto_secundario" android:text="Sua coleção está vazia"/>
      <LinearLayout android:id="@+id/listaJogos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="vertical" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:text="Sua atividade" android:textColor="@color/texto" android:textSize="16sp" android:textStyle="bold"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/resumoTotal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="65dp" android:gravity="center" android:background="@drawable/bg_card_jogo" android:textColor="@color/texto" android:textSize="12sp"/>
        <TextView android:id="@+id/resumoJogando" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="7dp" android:layout_height="65dp" android:gravity="center" android:background="@drawable/bg_card_jogo" android:textColor="@color/texto" android:textSize="12sp"/>
        <TextView android:id="@+id/resumoZerados" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="7dp" android:layout_height="65dp" android:gravity="center" android:background="@drawable/bg_card_jogo" android:textColor="@color/texto" android:textSize="12sp"/>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/resumoHoras" android:layout_width="0dp" android:layout_weight="1" android:layout_height="55dp" android:gravity="center" android:background="@drawable/bg_card_jogo" android:textColor="@color/texto" android:textSize="12sp"/>
        <TextView android:id="@+id/resumoMediaProgresso" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_height="55dp" android:gravity="center" android:background="@drawable/bg_card_jogo" android:textColor="@color/texto" android:textSize="12sp"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <include layout="@layout/bottom_navigation"/>
</LinearLayout>
