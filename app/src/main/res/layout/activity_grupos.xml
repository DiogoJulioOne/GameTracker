<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_tela_gametracker" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="20dp">
        <include layout="@layout/gt_brand_header" /><TextView android:id="@+id/textoTituloGrupos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grupos" android:textColor="@color/texto" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/textoDescricaoGrupos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Encontre pessoas para jogar e crie sua comunidade." android:textColor="@color/texto_secundario" android:textSize="14sp" />
        <Button android:textColor="@color/black" android:id="@+id/botaoCriarGrupo" style="@style/BotaoPrincipal" android:layout_marginTop="18dp" android:text="+ Criar grupo" android:textAllCaps="false" android:fontFamily="sans-serif-medium" />
        <EditText android:id="@+id/pesquisaGrupos" style="@style/CampoTexto" android:layout_marginTop="12dp" android:hint="Buscar grupos ou jogos..." android:inputType="text" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:textColor="@color/black" android:id="@+id/botaoMeusGrupos" style="@style/BotaoSecundario" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:text="Meus grupos" android:textAllCaps="false" android:fontFamily="sans-serif-medium" />
            <Button android:textColor="@color/black" android:id="@+id/botaoExplorarGrupos" style="@style/BotaoSecundario" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="7dp" android:text="Explorar" android:textAllCaps="false" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/listaGrupos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp" />
        </ScrollView>
    </LinearLayout>
    <include layout="@layout/bottom_navigation" />
</LinearLayout>