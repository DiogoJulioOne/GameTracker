<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tela_gametracker">

    <LinearLayout
        android:id="@+id/topoDescoberta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <com.example.gametracker.utils.MarcaGameTrackerView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GameTracker" android:textColor="@color/destaque" android:textSize="26sp" android:fontFamily="sans-serif-black" android:letterSpacing="-0.035" android:textStyle="bold"/>
            <TextView android:id="@+id/tituloDescoberta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Descobrir" android:textColor="@color/texto" android:textSize="25sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/buttonLupa"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_botao_principal"
            android:contentDescription="@string/descoberta_lupa_desc"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/black"
            android:textSize="20sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editPesquisaDescoberta"
        style="@style/CampoTexto"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:hint="@string/descoberta_pesquisa_hint"
        android:imeOptions="actionSearch"
        android:inputType="textCapWords"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topoDescoberta" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editPesquisaDescoberta">

        <FrameLayout
            android:id="@+id/pilhaDescoberta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_botao_secundario"
                android:padding="8dp"
                android:text="✕  Esquerda: passar"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_botao_principal"
                android:padding="8dp"
                android:text="➜  Direita: pedir amizade"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoVazioDescoberta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/descoberta_sem_resultados"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="78dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
